{
  "functions": {
    "api/eligibilityWorker.cjs": {
      "maxDuration": 10,
      "cron": "* * * * *"
    },
  },
  "rewrites": [
    { "source": "/api/eligibility/(.*)", "destination": "/api/index.js" },
    { "source": "/api/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
