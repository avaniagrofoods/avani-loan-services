{
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/eligibility/(.*)", "destination": "/api/index.js" },
    { "source": "/api/auth/(.*)", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
